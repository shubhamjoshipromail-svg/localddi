# Everything here is optional. localddi needs no API keys to run.

# Port published on the host by docker compose.
LOCALDDI_PORT=8080

# If set, every endpoint except /health requires this key
# (header "X-API-Key: ..." or "Authorization: Bearer ...").
LOCALDDI_API_KEY=

# Comma-separated browser origins allowed by CORS. Empty means no CORS headers.
LOCALDDI_CORS_ORIGINS=

# Outside Docker: where the database and downloads live (default ./data).
# LOCALDDI_DATA_DIR=./data
